{
    "name": "spin-vscode",
    "publisher": "fermyon",
    "displayName": "Spin",
    "description": "Build and test Spin components from within VS Code",
    "icon": "images/spin-icon.png",
    "version": "0.8.0",
    "preview": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/fermyon/spin-vscode"
    },
    "license": "Apache-2.0",
    "engines": {
        "vscode": "^1.63.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCommand:spin.addToTerminalPath",
        "onCommand:spin.deploy",
        "onCommand:spin.connect",
        "onCommand:spin.openDashboard",
        "onCommand:spin.onStatusBarItemClicked",
        "onCommand:spin.dashboard.start",
        "onCommand:spin.dashboard.stop",
        "onCommand:spin.dashboard.onStatusBarItemClicked",
        "onTaskType:spin"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "category": "Spin",
                "command": "spin.addToTerminalPath",
                "title": "Add to Terminal Path"
            },
            {
                "category": "Spin",
                "command": "spin.deploy",
                "title": "Deploy"
            },
            {
                "category": "Spin",
                "command": "spin.connect",
                "title": "Log In"
            },
            {
                "category": "Spin",
                "command": "spin.openDashboard",
                "title": "Open Dashboard"
            },
            {
                "category": "Spin",
                "command": "spin.onStatusBarItemClicked",
                "title": "On Status Bar Item Clicked"
            },
            {
                "category": "Spin",
                "command": "spin.dashboard.start",
                "title": "Start Dev Dashboard"
            },
            {
                "category": "Spin",
                "command": "spin.dashboard.stop",
                "title": "Stop Dev Dashboard"
            },
            {
                "category": "Spin",
                "command": "spin.dashboard.onStatusBarItemClicked",
                "title": "On Dashboard Status Bar Item Clicked"
            }
        ],
        "configuration": {
            "title": "Spin",
            "properties": {
                "spin.customProgramPath": {
                    "type": "string",
                    "description": "Path of a Spin binary to use instead of the auto-installed binary"
                },
                "spin.deployPlugin": {
                    "type": "string",
                    "default": "",
                    "description": "Default deployment plugin for `spin login`/`spin deploy` (e.g. \"cloud\", \"aka\"). Sets the SPIN_DEPLOY_PLUGIN environment variable Spin uses to pick a deployment target when more than one deploy-capable plugin is installed. Run `spin plugins list --installed` in a terminal to see your installed plugin names. Leave blank to use Spin's own default behavior."
                },
                "spin.dashboardOpenIn": {
                    "type": "string",
                    "enum": ["browser", "webview"],
                    "default": "browser",
                    "description": "Where to open the Spin Dev Dashboard: your default external browser, or an embedded VS Code panel"
                },
                "spin.dashboardPort": {
                    "type": "number",
                    "default": 3001,
                    "description": "Port for the Spin Dev Dashboard HTTP server"
                },
                "spin.dashboardPluginUrl": {
                    "type": "string",
                    "default": "https://github.com/radu-matei/dash/releases/download/canary/dashboard.json",
                    "description": "Plugin manifest URL used to install the Spin Dashboard plugin. The plugin is not yet listed in Spin's official plugin catalog, so it's installed from this manifest instead of by name."
                }
            }
        },
        "menus": {
            "commandPalette": [
                {
                    "command": "spin.openDashboard",
                    "when": "spin.connected"
                },
                {
                    "command": "spin.onStatusBarItemClicked",
                    "when": "false"
                },
                {
                    "command": "spin.dashboard.stop",
                    "when": "spin.dashboardRunning"
                },
                {
                    "command": "spin.dashboard.onStatusBarItemClicked",
                    "when": "false"
                }
            ]
        },
        "taskDefinitions": [
            {
                "type": "spin",
                "when": "shellExecutionSupported",
                "required": [
                    "command"
                ],
                "properties": {
                    "command": {
                        "type": "string",
                        "description": "The Spin command to execute"
                    },
                    "options": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Options to pass on the Spin command line"
                    }
                }
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "webpack",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "lint": "eslint src",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^20.19.0",
        "@types/shelljs": "^0.8.17",
        "@types/tmp": "^0.2.6",
        "@types/vscode": "^1.63.0",
        "@types/yauzl": "^3.4.0",
        "@vscode/test-electron": "^2.5.2",
        "eslint": "^10.13.0",
        "glob": "^14.0.3",
        "mocha": "^10.8.2",
        "ts-loader": "^9.6.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.1",
        "webpack": "^5.112.2",
        "webpack-cli": "^7.2.3"
    },
    "dependencies": {
        "@octokit/rest": "^22.0.1",
        "got": "^11.8.6",
        "mkdirp": "^3.0.1",
        "rxjs": "^7.8.2",
        "shelljs": "^0.8.5",
        "spawn-rx": "^3.0.0",
        "tar": "^7.5.22",
        "tmp": "^0.2.7",
        "xdg-portable": "^10.6.0",
        "yauzl": "^3.4.0"
    },
    "overrides": {
        "serialize-javascript": "^7.1.4"
    }
}
